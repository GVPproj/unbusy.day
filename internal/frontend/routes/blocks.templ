package routes

import (
	"github.com/GVPproj/unbusy.day/internal/block"
	"github.com/GVPproj/unbusy.day/internal/frontend/components"
	"github.com/GVPproj/unbusy.day/internal/frontend/components/modals"
	"github.com/GVPproj/unbusy.day/internal/frontend/layouts"
	"github.com/GVPproj/unbusy.day/internal/jot"
)

// Initialize timezone before the body's stream request; child signals initialize later.
// retry 'always' reconnects even after a clean stream end.
templ BlocksPage(cs []block.Block, b block.Bounds, pads map[string]jot.Pad) {
	@layouts.Layout("unbusy.day", "$timezone = Intl.DateTimeFormat().resolvedOptions().timeZone; @get('/events', {retry: 'always', filterSignals: {include: /^timezone$/}})") {
		// Buffer live updates while the CodeMirror module graph loads.
		<script>
			window.__jotPending = new Map();
			window.__jotRemote = (note, version, text) => {
				const prior = window.__jotPending.get(note);
				if (!prior || version > prior[0]) window.__jotPending.set(note, [version, text]);
			};
		</script>
		// Note-scoped signals feed persistent editors, never element patches.
		// Underscore names keep note text off other endpoints' POSTs.
		<div
			class="shell"
			data-signals:_navopen="false"
			data-signals:_jotopen="false"
			data-signals:_jotdailyv="0"
			data-signals:_jotdailyt="''"
			data-signals:_jotweeklyv="0"
			data-signals:_jotweeklyt="''"
			data-signals:_jotquarterlyv="0"
			data-signals:_jotquarterlyt="''"
			data-on-signal-patch="window.__jotRemote?.('daily', $_jotdailyv, $_jotdailyt); window.__jotRemote?.('weekly', $_jotweeklyv, $_jotweeklyt); window.__jotRemote?.('quarterly', $_jotquarterlyv, $_jotquarterlyt)"
			data-on-signal-patch-filter="{include: /^_jot(daily|weekly|quarterly)v$/}"
		>
			@components.SideNav()
			@components.MenuToggle()
			@modals.ThemeModal()
			@modals.HoursModal(b, block.OccupiedEnvelope(cs))
			@modals.CreateModal()
			@modals.ClearModal()
			@modals.GuideModal()
			@modals.ShortcutsModal()
			@modals.DialogInit()
			<div id="sr-announce" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
			<div id="habit-reorder-instructions" class="sr-only">Hold Alt and press the Up or Down arrow key to move this habit, or Alt with Home or End to move it to the top or bottom.</div>
			// .shell/.panels/.column geometry lives in app.css's layout layer.
			// Both panels stay in the DOM at every width — below 52rem CSS hides
			// one, so switching is instant and the Jotpad keeps its text,
			// caret, and scroll position.
			<div class="panels" data-class:jot-open="$_jotopen">
				<main class="column">
					@components.DateHeading()
					@components.BlockColumn(cs, b)
					// Keyboard instructions stay outside #block-list so SSE morphs leave them intact.
					<div id="dnd-instructions" class="sr-only">Press Space or Enter to grab this block, then the Up and Down arrow keys (or j and k) to move it, and Space or Enter again to drop it. Press r or F2 to rename, or Delete to remove it. Tab to the resize handle to change its length. Press question mark for the full list of keyboard shortcuts.</div>
					// Block gestures live behind one init seam (blocks/gestures.js): pass the
					// list element and an announce *function* (the #sr-announce null-guard
					// lives here, with the DOM it owns). See the event-contract doc atop
					// blocks/gestures.js for the layout/rename/delete CustomEvents these
					// gestures dispatch onto #block-list below.
					<script type="module">
					import { initBlockGestures } from "/static/js/blocks/gestures.js"
					const list = document.getElementById("block-list")
					const announcer = document.getElementById("sr-announce")
					if (list) initBlockGestures(list, (msg) => {
						if (announcer) announcer.textContent = msg
					})
					// Two frames so the initial column paints once before .hydrated lands;
					// the block entry transition (app.css) then greets only SSE-inserted blocks.
					if (list) requestAnimationFrame(() => requestAnimationFrame(() => list.classList.add("hydrated")))
				</script>
					<script type="module" src="/static/js/now.js"></script>
					<script type="module" src="/static/js/shortcuts.js"></script>
				</main>
				@components.Companion(pads)
				<script type="module" src="/static/js/jot/notes.js"></script>
			</div>
		</div>
	}
}
