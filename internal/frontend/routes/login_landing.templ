package routes

import "github.com/GVPproj/unbusy.day/internal/frontend/components/modals"

templ loginLanding() {
	<div class="lp-quiet-story" id="discover">
		<section class="lp-feature">
			<div class="lp-copy">
				<h2>Block out time<br/>with levels of <em>focus</em>.</h2>
				<p>Making time for <strong>focused work</strong> gets easier when we give the other parts of our workday clear boundaries.</p>
			</div>
			@landingTypes()
		</section>
		<section class="lp-feature lp-reverse">
			<div class="lp-copy">
				<h2>Shape the <em>day</em>.</h2>
				<p>Create, stretch, resize, reorder. Watching our day plan fill up helps us avoid taking on too much.</p>
				<span class="lp-caption">← Try the interactive demo!</span>
			</div>
			<div class="lp-paper">@modals.LandingPlan(true)</div>
		</section>
		<section class="lp-feature">
			<div class="lp-copy">
				<h2>Build habits,<br/><em>take notes</em>.</h2>
				<p>Just enough to keep focused on the main thing.</p>
			</div>
			<div class="lp-paper companion" aria-label="Notes & Habits demo">
				<header class="companion-head">
					<div role="tablist" aria-label="Notes & Habits demo">
						<button type="button" id="demo-jot-tab" role="tab" aria-controls="demo-jot-panel" aria-selected="true" tabindex="0">Jotpad</button>
						<button type="button" id="demo-habits-tab" role="tab" aria-controls="demo-habits-panel" aria-selected="false" tabindex="-1">Habits</button>
					</div>
				</header>
				<div id="demo-jot-panel" role="tabpanel" aria-labelledby="demo-jot-tab" tabindex="0">@landingJot()</div>
				<div id="demo-habits-panel" role="tabpanel" aria-labelledby="demo-habits-tab" tabindex="0" hidden>@landingHabits()</div>
			</div>
			<script src="/static/js/companion.js"></script>
		</section>
	</div>
}

templ landingTypes() {
	<ul class="lp-types" aria-label="Four block types">
		<li data-type="deep"><div><strong>Focus</strong><span>Undistracted effort</span></div></li>
		<li data-type="shallow"><div><strong>Admin</strong><span>Chat, email, light tasks</span></div></li>
		<li data-type="break"><div><strong>Break</strong><span>Take regularly</span></div></li>
		<li data-type="appointment"><div><strong>Fixed</strong><span>Appointments, meetings</span></div></li>
	</ul>
}

templ landingJot() {
	<div class="lp-jot">
		<textarea aria-label="Try the Jotpad (not saved)" spellcheck="false">{ "A few things on my mind…\n\nAn idea for later\nA book to look up\nSomething I don't want to forget" }</textarea>
	</div>
}

templ landingHabits() {
	<div class="lp-habits">
		<div class="lp-mini-heading"><span>This week</span></div>
		<div class="lp-habit-week" aria-hidden="true"><span></span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span></div>
		for _, habit := range []string{"Read", "Walk", "Make time"} {
			<div class="lp-habit-row"><span>{ habit }</span>
				for i, day := range []string{"Monday", "Tuesday", "Wednesday", "Thursday", "Friday"} {
					<button type="button" data-demo-habit aria-label={ habit + " on " + day } aria-pressed={ map[bool]string{true: "true", false: "false"}[i < 2] }><span aria-hidden="true">✓</span></button>
				}
			</div>
		}
	</div>
}
