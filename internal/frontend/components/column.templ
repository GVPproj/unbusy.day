package components

import (
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/block"
)

// Styling lives in app.css: .date-heading, and @scope (.blocks) for the day
// grid (slots, gutter, slot-add, now-pill, block items).

// DateHeading holds today's date; on mobile it's a non-scrolling header bar
// above the scrolling block list.
//
// The date is the VIEWER's, not the server's — the server runs UTC, so a Go
// time.Now() here reads a day ahead all evening in western timezones. The
// inline classic script below fills the <h1> during parse (before first paint,
// so no flash of an empty bar); now.js's tick keeps it right across midnight.
templ DateHeading() {
	<div class="date-heading">
		<h1 id="date-heading"></h1>
		<script>
			// Format kept in sync with formatDate() in /static/js/now.js.
			document.getElementById("date-heading").textContent =
				new Date().toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });
		</script>
		// Live countdown of time left in the block active at the viewer's clock;
		// now.js reveals and ticks it (the server can't know that clock).
		// Hidden when no block is active; data-type drives the pill color.
		<span id="block-countdown" class="block-countdown" aria-hidden="true" hidden></span>
	</div>
}

// BlockColumn is the patch fragment: #block-list is the morph anchor every SSE
// patch lands on. Page and patch render share it so they can't drift.
//
// The data-on:* handlers below consume the layout/rename/delete CustomEvents
// that blocks/gestures.js dispatches onto #block-list (full contract documented
// atop static/js/blocks/gestures.js).
templ BlockColumn(cs []block.Block, b block.Bounds) {
	// data-preserve-attr: morphs sync attributes, which would strip the
	// client-added .hydrated gate (routes/blocks.templ) on the first SSE patch.
	<ul
		id="block-list"
		class="blocks"
		data-preserve-attr="class"
		data-day-start={ strconv.Itoa(int(b.Start)) }
		data-day-end={ strconv.Itoa(int(b.End)) }
		data-signals:layout="[]"
		data-signals:deleteid="''"
		data-signals:renameid="''"
		data-signals:renamelabel="''"
		data-on:layout="$layout = evt.detail.layout; @post('/blocks/layout')"
		data-on:rename="$renameid = evt.detail.id; $renamelabel = evt.detail.label; @post('/blocks/rename')"
		data-on:delete="$deleteid = evt.detail.id; @post('/blocks/delete')"
	>
		{{ occupied := block.OccupiedSlots(cs) }}
		{{ startsAt := byStartSlot(cs) }}
		for _, s := range b.Slots() {
			@slot(s, b, occupied[s])
			if c, ok := startsAt[s]; ok {
				@blockItem(c, b)
			}
		}
		// Render out-of-bounds blocks anyway so a stray one is never silently
		// dropped. Span-1 containment of the start slot exactly complements the
		// loop above — a block whose span merely leaks past End already rendered.
		for _, c := range cs {
			if !b.Contains(c.Position, 1) {
				@blockItem(c, b)
			}
		}
		@nowPill()
	</ul>
}

// nowPill renders hidden (the server can't know the viewer's clock) and
// now.js reveals it. Part of BlockColumn so it survives every morph;
// aria-hidden because it just duplicates the system clock.
templ nowPill() {
	<li
		id="now-pill"
		aria-hidden="true"
		hidden
	>
		<span class="now-time"></span>
	</li>
}

// slot is one 30-minute row of the day grid. Explicit grid-row keeps
// auto-placement from skipping rows blocks occupy; the "add" button renders
// only for free slots so it never sits behind a block in the tab order.
templ slot(s block.Slot, b block.Bounds, occupied bool) {
	// Half-hour rows (.half) get a dashed top rule; hour rows stay solid.
	<li
		class={ "slot", templ.KV("half", s%2 == 1) }
		data-slot={ strconv.Itoa(int(s)) }
		style={ "grid-row:" + strconv.Itoa(b.Row(s)) }
		if occupied {
			aria-hidden="true"
		}
	>
		<span
			class="gutter"
			aria-hidden="true"
		>{ s.Label() }</span>
		if !occupied {
			<button
				type="button"
				class="slot-add"
				commandfor="create-modal"
				command="show-modal"
				data-on:click={ "$addslot = " + strconv.Itoa(int(s)) }
				aria-label={ "Add block at " + s.Label() }
			>
				@IconPlus()
			</button>
		}
	</li>
}

// byStartSlot indexes blocks by start slot; no-overlap guarantees one per slot.
func byStartSlot(cs []block.Block) map[block.Slot]block.Block {
	m := make(map[block.Slot]block.Block, len(cs))
	for _, c := range cs {
		m[c.Position] = c
	}
	return m
}
