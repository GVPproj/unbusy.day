package modals

import "github.com/GVPproj/unbusy.day/internal/frontend/components"

// LandingPlan reuses the guide's miniature and in-memory gestures.
templ LandingPlan(interactive bool) {
	<div class="landing-guide-figure">
		@guideColumn(interactive, 7) {
			<span class="gc-add" style="grid-row:1">@components.IconPlus()</span>
			<span class="gc-block" data-type="deep" data-id="deep-work" data-slot="2" data-span="2" style="grid-row:2 / span 2">
				<span class="gc-label">Deep Work</span>@gcHandle()
			</span>
			<span class="gc-block" data-type="shallow" data-id="email" data-slot="4" data-span="1" style="grid-row:4 / span 1">
				<span class="gc-label">Email</span>@gcHandle()
			</span>
			<span class="gc-block" data-type="break" data-id="coffee" data-slot="5" data-span="2" style="grid-row:5 / span 2">
				<span class="gc-label">Coffee</span>@gcHandle()
			</span>
		}
	</div>
}
