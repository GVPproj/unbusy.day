package modals

// Picker ingredients (scheme swatch gradients, feeling fonts and preview
// glyphs); shared with the guide's "Power User?" pane so its miniatures
// can't drift from the picker.
const (
	// Every colourscheme is a family whose Light/Dark variant is chosen by the
	// modeOption toggle, so a family swatch splits its light variant's page bg
	// against its dark variant's block surface — the most chromatic pair, so the
	// families stay tellable apart at swatch size.
	swatchSolarized = "linear-gradient(135deg, hsl(44, 86%, 94%) 50%, hsl(192, 100%, 10%) 50%)"
	swatchNord      = "linear-gradient(135deg, hsl(220, 23%, 97%) 50%, hsl(216, 26%, 26%) 50%)"
	swatchCatppuccin = "linear-gradient(135deg, hsl(220, 23%, 95%) 50%, hsl(237, 16%, 23%) 50%)"

	// The mode rows preview the axis itself, not a family: a neutral light and
	// dark disc.
	swatchLight = "linear-gradient(135deg, hsl(0, 0%, 100%) 50%, hsl(0, 0%, 91%) 50%)"
	swatchDark  = "linear-gradient(135deg, hsl(0, 0%, 16%) 50%, hsl(0, 0%, 9%) 50%)"

	feelingCozyFont  = "Zen Maru Gothic, system-ui, sans-serif"
	feelingPixelFont = "Gohu, ui-monospace, monospace"
	feelingMonoFont  = "JetBrains Mono, ui-monospace, monospace"

	glyphCozy  = `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/><path fill="currentColor" fill-rule="evenodd" d="M12 7.25a.75.75 0 0 1 .75.75v3.69l2.28 2.28a.75.75 0 1 1-1.06 1.06l-2.5-2.5a.75.75 0 0 1-.22-.53V8a.75.75 0 0 1 .75-.75" clip-rule="evenodd"/></svg>`
	glyphPixel = `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 2h12v2H6zM2 6h2v12H2zm18 0h2v12h-2zm-2-2h2v2h-2zM4 4h2v2H4zm2 18h12v-2H6zm12-2h2v-2h-2zM4 20h2v-2H4zm7-14h2v7h-2zm2 7h2v2h-2zm2 2h2v2h-2z"/></svg>`
	// Octicons clock; the stroke attrs mirror app.css's .icon-mono
	// fattening so the preview matches the live icons.
	glyphMono = `<svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0.75" stroke-linejoin="round" aria-hidden="true"><path d="M12.5 7.25a.75.75 0 0 0-1.5 0v5.5c0 .27.144.518.378.651l3.5 2a.75.75 0 0 0 .744-1.302L12.5 12.315V7.25Z"/><path d="M12 1c6.075 0 11 4.925 11 11s-4.925 11-11 11S1 18.075 1 12 5.925 1 12 1ZM2.5 12a9.5 9.5 0 0 0 9.5 9.5 9.5 9.5 0 0 0 9.5-9.5A9.5 9.5 0 0 0 12 2.5 9.5 9.5 0 0 0 2.5 12Z"/></svg>`
)

// themeOption is one row in the picker; swatch shows the theme's bg/column split.
templ themeOption(id string, label string, swatch string) {
	<label class="option-row">
		<input
			type="radio"
			name="theme-colourscheme"
			data-bind:_colorscheme
			value={ id }
			class="sr-only"
		/>
		<span class="swatch" style={ "background: " + swatch }></span>
		{ label }
	</label>
}

// modeOption is one row in the Light/Dark group: the mode axis applies to
// whichever colourscheme family is active, so its swatch is neutral.
templ modeOption(id string, label string, swatch string) {
	<label class="option-row">
		<input
			type="radio"
			name="theme-colormode"
			data-bind:_colormode
			value={ id }
			class="sr-only"
		/>
		<span class="swatch" style={ "background: " + swatch }></span>
		{ label }
	</label>
}

// feelingOption previews the icon and font together. family must be unquoted:
// templ double-escapes quotes in a dynamic style attribute.
templ feelingOption(id string, label string, family string, pixel bool, preview templ.Component) {
	<label class="option-row" style={ "font-family: " + family }>
		<input
			type="radio"
			name="theme-feeling"
			data-bind:_feeling
			value={ id }
			class="sr-only"
		/>
		<span class={ "feeling-preview", templ.KV("pixelated", pixel) }>
			@preview
		</span>
		{ label }
	</label>
}

// The groups bind the layout's theme signals, so changes apply and persist
// without closing the dialog.
templ ThemeModal() {
	<dialog
		id="theme-modal"
		class="app-dialog"
		closedby="any"
		aria-labelledby="theme-modal-title"
	>
		<h2 id="theme-modal-title">Theme</h2>
		<fieldset class="theme-options">
			<legend>Feeling</legend>
			@feelingOption("cozy", "Cozy", feelingCozyFont, false, templ.Raw(glyphCozy))
			@feelingOption("mono", "Mono", feelingMonoFont, false, templ.Raw(glyphMono))
			@feelingOption("pixel", "Pixel", feelingPixelFont, true, templ.Raw(glyphPixel))
		</fieldset>
		<fieldset class="theme-options">
			<legend>Colours</legend>
			@themeOption("catppuccin", "Catppuccin", swatchCatppuccin)
			@themeOption("solarized", "Solarized", swatchSolarized)
			@themeOption("nord", "Nord", swatchNord)
		</fieldset>
		<fieldset class="theme-options">
			<legend>Light / Dark</legend>
			@modeOption("light", "Light", swatchLight)
			@modeOption("dark", "Dark", swatchDark)
		</fieldset>
		<footer>
			<button class="btn" commandfor="theme-modal" command="close">Done</button>
		</footer>
	</dialog>
}
