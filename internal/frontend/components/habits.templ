package components

import (
	"slices"
	"strconv"
	"time"

	"github.com/GVPproj/unbusy.day/internal/habit"
)

func checkInAction(habitID int64, date string) string {
	request := "$habitcheckinattempt++; el.dataset.attempt = $habitcheckinattempt; $habitid = " + strconv.FormatInt(habitID, 10) + "; $habitdate = '" + date + "'; $habitchecked = el.dataset.desired === 'true'; @post('/habits/check-in', {retry: 'never', retryMaxCount: 0, requestCancellation: 'disabled', filterSignals: {include: /^(habitid|habitdate|habitchecked|habitcheckinattempt|habitrefresh|habitview|timezone)$/}})"
	return "if (el.getAttribute('aria-busy') !== 'true') { " + request + " }"
}

func habitWeekday(date string) string {
	day, err := time.Parse(time.DateOnly, date)
	if err != nil {
		return ""
	}
	return day.Format("Mon")
}

func selectHabitWeek(week string) string {
	return "$habitview++; $_habitfollowing = false; $habitweek = '" + week + "'"
}

// View-owned week signals and dialogs stay mounted while the grid morphs.
templ Habits() {
	<div
		id="habit-matrix"
		class="habits-matrix"
		tabindex="0"
		role="region"
		aria-label="Weekly habits"
		data-on:close__capture="if (document.activeElement === document.body || evt.target.contains(document.activeElement)) el.focus()"
		data-signals:habitid="0"
		data-signals:habitdate="''"
		data-signals:habitchecked="false"
		data-signals:habitcheckinattempt="0"
		data-signals:_habitcheckinack="''"
		data-signals:habitread="0"
		data-on:habit-checkin-read="$habitread = evt.detail.read"
		data-signals:habitweek="''"
		data-signals:habitview="0"
		data-signals:_habitcurrentweek="''"
		data-signals:_habitfollowing="true"
		data-signals:habitrefresh="''"
		data-effect="if ($_habitfollowing && $_habitcurrentweek && $habitweek !== $_habitcurrentweek) $habitweek = $_habitcurrentweek; if ($timezone && $habitweek) { $habitrefresh; $habitread; @get('/habits/week', {filterSignals: {include: /^(habitweek|habitview|timezone|habitrefresh|habitread)$/}}) }"
	>
		@HabitGrid(nil, habit.Week{}, HabitView{})
		@HabitEditDialog()
		@HabitDeleteDialog()
	</div>
}

// HabitGrid is shared by initial rendering and every authoritative week patch.
// The rendered read is immutable; only the selector's request key follows signals.
templ HabitGrid(habits []habit.Habit, week habit.Week, view HabitView) {
	<div id="habit-grid" data-week={ week.Key } data-refresh={ view.Refresh } data-view={ strconv.FormatUint(view.View, 10) } data-read={ strconv.FormatUint(view.Read, 10) } data-read-request={ strconv.FormatUint(view.Read, 10) } data-attr:data-week="$habitweek" data-attr:data-refresh="$habitrefresh" data-attr:data-view="$habitview" data-attr:data-read-request="$habitread">
		if week.Today == "" {
			<p>Loading your current week…</p>
		} else {
			<nav class="week-nav" aria-label="Habit week">
				<h2 aria-live="polite"><time datetime={ week.Key } aria-label={ week.Label }>{ week.ShortLabel }</time></h2>
				<button id="habit-previous-week" class="btn" type="button" data-on:click={ selectHabitWeek(week.Previous) } aria-label={ "Previous week, " + week.Previous }>
					@IconChevronLeft()
				</button>
				<button id="habit-next-week" class="btn" type="button" disabled?={ week.Current } data-on:click={ selectHabitWeek(week.Next) } aria-label={ "Next week" }>
					@IconChevronRight()
				</button>
				<button id="habit-this-week" class="btn" type="button" data-attr:disabled="$_habitfollowing && $habitweek === $_habitcurrentweek" data-on:click="$habitview++; $_habitfollowing = true; $habitweek = $_habitcurrentweek">This week</button>
			</nav>
			if len(habits) == 0 {
				<p>No habits yet in this week. Create a habit to begin.</p>
			} else {
				<div id="habit-scroll" class="habit-scroll" tabindex="0" role="region" aria-label="Habit check-ins, scroll for more dates">
					<table>
						<caption class="sr-only">{ week.Label } habit check-ins</caption>
						<thead>
							<tr>
								<th scope="col">Habit</th>
								for _, date := range week.Dates {
									<th scope="col" class={ templ.KV("today", date == week.Today) }>
										<span>{ habitWeekday(date) }</span>
										<time datetime={ date } if date == week.Today {
											aria-current="date"
										}>{ date[8:] }</time>
									</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, h := range habits {
								<tr id={ "habit-" + strconv.FormatInt(h.ID, 10) }>
									<th scope="row" aria-label={ h.Name }>
										<div class="habit-heading">
											<span class="habit-name" title={ h.Name }>{ h.Name }</span>
											<button
												id={ "habit-edit-" + strconv.FormatInt(h.ID, 10) }
												class="habit-action"
												type="button"
												commandfor="habit-edit"
												command="show-modal"
												data-on:click={ openHabitEditor(h) }
												aria-label={ "Edit " + h.Name }
												title="Edit habit"
											>
												@IconEdit()
											</button>
											<button
												id={ "habit-delete-" + strconv.FormatInt(h.ID, 10) }
												class="habit-action"
												type="button"
												commandfor="habit-delete"
												command="show-modal"
												data-on:click={ openHabitDelete(h) }
												aria-label={ "Delete " + h.Name }
												title="Delete habit"
											>
												@IconClear()
											</button>
										</div>
									</th>
									for _, date := range week.Dates {
										<td class={ templ.KV("today", date == week.Today), templ.KV("unavailable", date < h.StartDate || date > week.Today) }>
											if date < h.StartDate || date > week.Today {
												<span aria-label={ date + ": unavailable" }>—</span>
											} else {
												{{ checked := slices.Contains(h.CheckedDates, date) }}
												<button
													type="button"
													class="check-in"
													id={ "checkin-" + strconv.FormatInt(h.ID, 10) + "-" + date }
													aria-label={ h.Name + " on " + date }
													aria-pressed={ strconv.FormatBool(checked) }
													data-checkin-action
													data-desired={ strconv.FormatBool(!checked) }
													data-on:click={ checkInAction(h.ID, date) }
												>
													if checked {
														@IconCheck()
													}
												</button>
											}
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			@HabitCheckInFeedback("", "")
		}
	</div>
}

templ HabitCheckInFeedback(message, result string) {
	<output id="habit-checkin-feedback" aria-live="polite" data-result={ result }>{ message }</output>
}
