package components

import (
	"slices"
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/habit"
)

func checkInAction(habitID int64, date string, checked bool) string {
	request := "$habitid = " + strconv.FormatInt(habitID, 10) + "; $habitdate = '" + date + "'; $habitchecked = " + strconv.FormatBool(!checked) + "; @post('/habits/check-in', {retry: 'never', retryMaxCount: 0, requestCancellation: 'disabled', filterSignals: {include: /^(habitid|habitdate|habitchecked|timezone)$/}})"
	return "if (el.getAttribute('aria-busy') !== 'true') { " + request + " }"
}

// The scroll container stays mounted while its server-rendered grid morphs.
templ Habits(habits []habit.Habit, month habit.Month) {
	<div
		id="habit-matrix"
		class="habits-matrix"
		tabindex="0"
		role="region"
		aria-label="Monthly habits, scroll for more dates"
		data-signals:habitid="0"
		data-signals:habitdate="''"
		data-signals:habitchecked="false"
	>
		@HabitGrid(habits, month)
	</div>
}

// HabitGrid is shared by initial rendering and every ordered live patch.
templ HabitGrid(habits []habit.Habit, month habit.Month) {
	<div id="habit-grid">
		if month.Today == "" {
			<p>Loading your current month…</p>
		}
		if len(habits) == 0 {
			<p>No habits yet. Create your first habit below.</p>
		} else {
			<table>
				<caption>{ month.Label }</caption>
				<thead>
					<tr>
						<th scope="col">Habit</th>
						for _, date := range month.Dates {
							<th scope="col"><time datetime={ date }>{ date[8:] }</time></th>
						}
					</tr>
				</thead>
				<tbody>
					for _, h := range habits {
						<tr id={ "habit-" + strconv.FormatInt(h.ID, 10) }>
							<th scope="row">{ h.Name }</th>
							for _, date := range month.Dates {
								<td class={ templ.KV("unavailable", date < h.StartDate || date > month.Today) }>
									if date < h.StartDate || date > month.Today {
										<span aria-label={ date + ": unavailable" }>—</span>
									} else {
										{{ checked := slices.Contains(h.CheckedDates, date) }}
										<button
											type="button"
											class="check-in"
											id={ "checkin-" + strconv.FormatInt(h.ID, 10) + "-" + date }
											aria-label={ h.Name + " on " + date }
											aria-pressed={ strconv.FormatBool(checked) }
											data-checkin-action
											data-desired={ strconv.FormatBool(!checked) }
											data-on:click={ checkInAction(h.ID, date, checked) }
										>
											<span aria-hidden="true">
												if checked {
													✓
												} else {
													·
												}
											</span>
										</button>
									}
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
		@HabitCheckInFeedback("", "")
	</div>
}

templ HabitCheckInFeedback(message, result string) {
	<output id="habit-checkin-feedback" aria-live="polite" data-result={ result }>{ message }</output>
}

templ HabitFeedback(message string) {
	<output id="habit-feedback" aria-live="polite">{ message }</output>
}
