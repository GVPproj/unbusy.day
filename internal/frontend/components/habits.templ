package components

import (
	"slices"
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/habit"
)

func checkInAction(habitID int64, date string, checked bool) string {
	request := "$habitid = " + strconv.FormatInt(habitID, 10) + "; $habitdate = '" + date + "'; $habitchecked = " + strconv.FormatBool(!checked) + "; @post('/habits/check-in', {retry: 'never', retryMaxCount: 0, requestCancellation: 'disabled', filterSignals: {include: /^(habitid|habitdate|habitchecked|habitrefresh|habitview|timezone)$/}})"
	return "if (el.getAttribute('aria-busy') !== 'true') { " + request + " }"
}

func selectHabitMonth(month string) string {
	return "$habitview++; $_habitfollowing = false; $habitmonth = '" + month + "'"
}

func openHabitEditor(h habit.Habit) string {
	return "$habiteditview++; $habiteditid = " + strconv.FormatInt(h.ID, 10) + "; $habiteditname = " + strconv.Quote(h.Name) + "; $habiteditstart = '" + h.StartDate + "'"
}

func openHabitDelete(h habit.Habit) string {
	return "$habitdeleteview++; $habitdeleteid = " + strconv.FormatInt(h.ID, 10) + "; $_habitdeletename = " + strconv.Quote(h.Name) + "; $_habitdeleteerror = ''"
}

// The scroll container and view-owned month signals stay mounted while the grid morphs.
templ Habits(habits []habit.Habit, month habit.Month) {
	<div
		id="habit-matrix"
		class="habits-matrix"
		tabindex="0"
		role="region"
		aria-label="Monthly habits, scroll for more dates"
		data-on:close__capture="if (document.activeElement === document.body || evt.target.contains(document.activeElement)) el.focus()"
		data-signals:habitid="0"
		data-signals:habitdate="''"
		data-signals:habitchecked="false"
		data-signals:habiteditid="0"
		data-signals:habiteditname="''"
		data-signals:habiteditstart="''"
		data-signals:habiteditview="0"
		data-signals:_habiteditsavedview="0"
		data-signals:_habitediterror="''"
		data-signals:_habitediterrorview="0"
		data-signals:habitdeleteid="0"
		data-signals:habitdeleteview="0"
		data-signals:_habitdeletename="''"
		data-signals:_habitdeletesavedview="0"
		data-signals:_habitdeleteerror="''"
		data-signals:_habitdeleteerrorview="0"
		data-signals:habitmonth="''"
		data-signals:habitview="0"
		data-signals:_habitcurrent="''"
		data-signals:_habitfollowing="true"
		data-signals:habitrefresh="''"
		data-effect="if ($_habitfollowing && $_habitcurrent && $habitmonth !== $_habitcurrent) $habitmonth = $_habitcurrent; if ($timezone && $habitmonth) { $habitrefresh; @get('/habits/month', {filterSignals: {include: /^(habitmonth|habitview|timezone|habitrefresh)$/}}) }"
	>
		@HabitGrid(habits, month, "", 0)
		@HabitEditDialog()
		@HabitDeleteDialog()
	</div>
}

// HabitGrid is shared by initial rendering and every authoritative month patch.
templ HabitGrid(habits []habit.Habit, month habit.Month, refresh string, view uint64) {
	<div id="habit-grid" data-month={ month.Key } data-refresh={ refresh } data-view={ strconv.FormatUint(view, 10) } data-attr:data-month="$habitmonth" data-attr:data-refresh="$habitrefresh" data-attr:data-view="$habitview">
		if month.Today == "" {
			<p>Loading your current month…</p>
		} else {
			<nav class="month-nav" aria-label="Habit month">
				<button id="habit-previous-month" class="btn" type="button" data-on:click={ selectHabitMonth(month.Previous) } aria-label={ "Previous month, " + month.Previous }>Previous</button>
				<h2 aria-live="polite"><time datetime={ month.Key }>{ month.Label }</time></h2>
				<button id="habit-next-month" class="btn" type="button" disabled?={ month.Current } data-on:click={ selectHabitMonth(month.Next) } aria-label={ "Next month" }>Next</button>
				<button id="habit-this-month" class="btn" type="button" disabled?={ month.Current } data-on:click="$habitview++; $_habitfollowing = true; $habitmonth = $_habitcurrent">This month</button>
			</nav>
			if len(habits) == 0 {
				<p>No habits yet in this month. Create a habit to begin.</p>
			} else {
				<table>
					<caption class="sr-only">{ month.Label } habit check-ins</caption>
					<thead>
						<tr>
							<th scope="col">Habit</th>
							for _, date := range month.Dates {
								<th scope="col"><time datetime={ date }>{ date[8:] }</time></th>
							}
						</tr>
					</thead>
					<tbody>
						for _, h := range habits {
							<tr id={ "habit-" + strconv.FormatInt(h.ID, 10) }>
								<th scope="row" aria-label={ h.Name }>
									<span>{ h.Name }</span>
									<button
										id={ "habit-edit-" + strconv.FormatInt(h.ID, 10) }
										class="habit-action"
										type="button"
										commandfor="habit-edit"
										command="show-modal"
										data-on:click={ openHabitEditor(h) }
										aria-label={ "Edit " + h.Name }
									>Edit</button>
									<button
										id={ "habit-delete-" + strconv.FormatInt(h.ID, 10) }
										class="habit-action"
										type="button"
										commandfor="habit-delete"
										command="show-modal"
										data-on:click={ openHabitDelete(h) }
										aria-label={ "Delete " + h.Name }
									>Delete</button>
								</th>
								for _, date := range month.Dates {
									<td class={ templ.KV("unavailable", date < h.StartDate || date > month.Today) }>
										if date < h.StartDate || date > month.Today {
											<span aria-label={ date + ": unavailable" }>—</span>
										} else {
											{{ checked := slices.Contains(h.CheckedDates, date) }}
											<button
												type="button"
												class="check-in"
												id={ "checkin-" + strconv.FormatInt(h.ID, 10) + "-" + date }
												aria-label={ h.Name + " on " + date }
												aria-pressed={ strconv.FormatBool(checked) }
												data-checkin-action
												data-desired={ strconv.FormatBool(!checked) }
												data-on:click={ checkInAction(h.ID, date, checked) }
											>
												<span aria-hidden="true">
													if checked {
														✓
													} else {
														·
													}
												</span>
											</button>
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			}
			@HabitCheckInFeedback("", "")
		}
	</div>
}

templ HabitEditDialog() {
	<dialog id="habit-edit" class="app-dialog" closedby="any" aria-labelledby="habit-edit-title" data-effect="if ($_habiteditsavedview === $habiteditview && el.open) el.close()">
		<form
			class="habit-dialog-form"
			data-indicator:_habiteditpending
			data-on:submit="if (!$_habiteditpending && el.reportValidity()) @post('/habits/edit', {requestCancellation: 'disabled', filterSignals: {include: /^(habiteditid|habiteditname|habiteditstart|habiteditview|timezone)$/}})"
			data-attr:aria-busy="$_habiteditpending"
		>
			<h2 id="habit-edit-title">Edit habit</h2>
			<label class="stack" for="habit-edit-name">Name <input class="field" id="habit-edit-name" name="name" type="text" required data-bind:habiteditname/></label>
			<label class="stack" for="habit-edit-start">Start date <input class="field" id="habit-edit-start" name="start" type="date" required data-bind:habiteditstart/></label>
			<footer>
				<button class="btn" type="button" commandfor="habit-edit" command="close">Cancel</button>
				<button class="btn" type="submit" data-attr:disabled="$_habiteditpending">Save</button>
			</footer>
			@HabitEditFeedback()
		</form>
	</dialog>
}

templ HabitDeleteDialog() {
	<dialog
		id="habit-delete"
		class="app-dialog"
		closedby="any"
		aria-labelledby="habit-delete-title"
		aria-describedby="habit-delete-warning"
		data-effect="if ($_habitdeletesavedview === $habitdeleteview && el.open) { el.close(); document.getElementById('habit-matrix').focus() }"
	>
		<form
			class="habit-dialog-form"
			data-indicator:_habitdeletepending
			data-on:submit="if (!$_habitdeletepending) { el.dataset.submittedView = $habitdeleteview; $_habitdeleteerror = ''; @post('/habits/delete', {retry: 'never', retryMaxCount: 0, requestCancellation: 'disabled', filterSignals: {include: /^(habitdeleteid|habitdeleteview)$/}}) }"
			data-on:datastar-fetch__document="if (evt.detail.el === el && ['error', 'retries-failed'].includes(evt.detail.type)) { $_habitdeleteerrorview = Number(el.dataset.submittedView); $_habitdeleteerror = 'Deletion not confirmed. Try again.' }"
			data-attr:aria-busy="$_habitdeletepending"
		>
			<h2 id="habit-delete-title">Delete habit</h2>
			<p id="habit-delete-warning">Permanently delete <strong data-text="$_habitdeletename"></strong>? All check-in history will be permanently deleted. This cannot be undone.</p>
			<footer>
				<button class="btn" type="button" commandfor="habit-delete" command="close" autofocus>Cancel</button>
				<button class="btn btn-danger" type="submit" data-attr:disabled="$_habitdeletepending">Delete permanently</button>
			</footer>
			<output aria-live="polite" data-text="$_habitdeleteerrorview === $habitdeleteview ? $_habitdeleteerror : ''"></output>
		</form>
	</dialog>
}

templ HabitEditFeedback() {
	<output id="habit-edit-feedback" aria-live="polite" data-text="$_habitediterrorview === $habiteditview ? $_habitediterror : ''"></output>
}

templ HabitCheckInFeedback(message, result string) {
	<output id="habit-checkin-feedback" aria-live="polite" data-result={ result }>{ message }</output>
}

templ HabitFeedback(message string) {
	<output id="habit-feedback" aria-live="polite">{ message }</output>
}
