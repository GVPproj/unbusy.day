package components

// Throwaway switcher for three landing directions on /login?variant=A|B|C.
templ PrototypeSwitcher(variant string) {
	{{ keys := []string{"A", "B", "C"} }}
	{{ names := []string{"Quiet reveal", "Editorial", "Field guide"} }}
	{{ index := map[string]int{"B": 1, "C": 2}[variant] }}
	<nav
		class="prototype-switcher"
		aria-label="Landing prototype variants"
		data-variant={ keys[index] }
		data-direction-name={ names[index] }
	>
		<a
			rel="prev"
			href={ "/login?variant=" + keys[(index+2)%3] }
			aria-label="Previous prototype variant"
			aria-keyshortcuts="ArrowLeft"
		>←</a>
		<div class="prototype-switcher-label">
			<strong>{ keys[index] + " · " + names[index] }</strong>
			<small>Prototype · nothing saved</small>
		</div>
		<a
			rel="next"
			href={ "/login?variant=" + keys[(index+1)%3] }
			aria-label="Next prototype variant"
			aria-keyshortcuts="ArrowRight"
		>→</a>
	</nav>
	<script type="module" src="/static/js/landing-prototype.js"></script>
}
