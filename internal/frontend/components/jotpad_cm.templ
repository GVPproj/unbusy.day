package components

// PROTOTYPE — branch prototype/jotpad-codemirror. CodeMirror 6 variant of the
// Jotpad, rendered when the page is loaded with ?jot=cm (see routes/blocks.templ).
// Throwaway: not for main.

import (
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/jot"
)

// JotpadCM mounts an empty div that jot-cm.js turns into a CodeMirror editor;
// the stored text travels as a JSON script so no escaping can mangle it.
templ JotpadCM(pad jot.Pad) {
	<aside class="column jotpad jotpad-cm" aria-labelledby="jot-heading">
		<div class="jot-head">
			<h2 id="jot-heading">Jotpad <span class="proto-badge">CM</span></h2>
			@jotStatus()
		</div>
		@templ.JSONScript("jot-cm-text", pad.Text)
		<div
			id="jot-cm"
			data-maxlen={ strconv.Itoa(jot.MaxLen) }
			data-jot-version={ strconv.FormatInt(pad.Version, 10) }
		></div>
	</aside>
}
