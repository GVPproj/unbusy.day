package components

// Throwaway: the real login presentation with a local-only form (UNB-77).
templ PrototypeLoginAmoeba() {
	@loginAmoeba() {
		<form id="prototype-login" onsubmit="event.preventDefault()">
			<p id="prototype-login-status">We'll email you a one-time code.</p>
			<input type="email" placeholder="you@example.com" autocomplete="email" required aria-label="Email address"/>
			<button type="submit">Send code</button>
			<button type="button" class="outline-btn" commandfor="guide-modal" command="show-modal">🤔 What is it?</button>
		</form>
	}
}
