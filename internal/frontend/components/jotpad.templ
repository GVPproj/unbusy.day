package components

import (
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/jot"
)

// Styling lives in app.css: @scope (.jotpad), plus .panels in the layout layer.

// Newlines are legal in a textarea placeholder and render as line breaks,
// letting the empty pad sketch a weekly outline.
const jotPlaceholder = `e.g.

## Monday

- call Mom

## Tuesday

## Wednesday

## Thursday

## Friday`

// jotStatus is the save-state indicator, updated by the client sync driver
// only (client-only state — no Datastar signal, the server doesn't care).
// <output> is an implicit role=status live region, so state changes are
// announced without stealing focus.
templ jotStatus() {
	<output id="jot-status" class="jot-status" data-state="saved">Saved</output>
}

// Jotpad is the second panel, an <aside> because two <main>s are invalid HTML —
// which also gives screen readers two named landmarks to move between.
// Saving is owned entirely by jot.js (debounce, compare-and-swap version,
// retry, teardown beacon): /jot answers JSON now, which Datastar's @post
// cannot read, so there is no data-bind/@post wiring to drift against it.
templ Jotpad(pad jot.Pad) {
	<aside class="column jotpad" aria-labelledby="jot-heading">
		<div class="jot-head">
			<h2 id="jot-heading">Jotpad</h2>
			@jotStatus()
		</div>
		// The leading newline is sacrificial: an HTML parser drops one right
		// after the start tag, so without it a jot starting blank loses that line.
		<textarea
			id="jot"
			aria-labelledby="jot-heading"
			maxlength={ strconv.Itoa(jot.MaxLen) }
			placeholder={ jotPlaceholder }
			data-jot-version={ strconv.FormatInt(pad.Version, 10) }
		>{ "\n" + pad.Text }</textarea>
	</aside>
}
