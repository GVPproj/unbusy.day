package components

import (
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/jot"
)

// Styling lives in app.css: @scope (.jotpad), plus .panels in the layout layer.

// jotStatus is the save-state indicator, updated by the client sync driver
// only (client-only state — no Datastar signal, the server doesn't care).
// <output> is an implicit role=status live region, so state changes are
// announced without stealing focus.
templ jotStatus() {
	<output id="jot-status" class="jot-status" data-state="saved">Saved</output>
}

// Jotpad is the second panel, an <aside> because two <main>s are invalid HTML —
// which also gives screen readers two named landmarks to move between.
// The editing surface is CodeMirror 6: jot-cm.js mounts it into #jot-cm and
// owns everything client-side (markdown keymap, placeholder, saving via the
// jot-sync driver). The stored text travels as a JSON script so no escaping
// can mangle it.
templ Jotpad(pad jot.Pad) {
	<aside class="column jotpad" aria-labelledby="jot-heading">
		<div class="jot-head">
			<h2 id="jot-heading">Jotpad</h2>
			@jotStatus()
		</div>
		@templ.JSONScript("jot-cm-text", pad.Text)
		<div
			id="jot-cm"
			data-maxlen={ strconv.Itoa(jot.MaxLen) }
			data-jot-version={ strconv.FormatInt(pad.Version, 10) }
		></div>
	</aside>
}
