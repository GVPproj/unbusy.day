package components

import (
	"strconv"

	"github.com/GVPproj/unbusy.day/internal/jot"
)

// Styling lives in app.css: @scope (.jotpad).

// The companion keeps this editor mounted across tab switches and matrix patches.
// Stored text travels as JSON so escaping cannot mangle it.
templ Jotpad(pad jot.Pad) {
	<section class="jotpad" aria-labelledby="jot-tab">
		@templ.JSONScript("jot-cm-text", pad.Text)
		<div
			id="jot-cm"
			data-maxlen={ strconv.Itoa(jot.MaxLen) }
			data-jot-version={ strconv.FormatInt(pad.Version, 10) }
		></div>
	</section>
}
